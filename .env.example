# Captura de leads — /api/visit-lead

# OBRIGATÓRIO: email pra Denise/Simone via Resend
RESEND_API_KEY=re_...                                # mesma key do Lumied
RESEND_FROM=Maple Bear Caxias <site@maplebearcaxiasdosul.com.br>
LEAD_NOTIFY_TO=denise@maplebearcaxiasdosul.com.br,simone@maplebearcaxiasdosul.com.br

# OPCIONAL: integração Lumied (cria lead no CRM da escola Caxias)
# Se ausente, o endpoint funciona só com Resend
LUMIED_API_URL=https://brgorknbrjlfwvrrlwxj.supabase.co/functions/v1/api
LUMIED_ANON_KEY=eyJhbGciOiJIUzI1NiI...               # supabase anon key (mesma do app Lumied)
LUMIED_ESCOLA_SLUG=maplebearcaxias                   # slug da escola, default já é maplebearcaxias

# Aviso dos leads vindos do site de Bento Gonçalves (postam neste endpoint com escola:'maplebearbg')
LEAD_NOTIFY_TO_BG=contato@maplebearbg.com.br

# Banco de Talentos — /api/curriculos (currículos de /trabalhe-conosco/)
# Reusa RESEND_API_KEY + LUMIED_API_URL + LUMIED_ANON_KEY acima.
# Para quem o e-mail de novo currículo é enviado (RH/direção). Por unidade:
TALENTOS_NOTIFY_TO=denise@maplebearcaxiasdosul.com.br,simone@maplebearcaxiasdosul.com.br
TALENTOS_NOTIFY_TO_BG=contato@maplebearbg.com.br          # ajustar para o e-mail de RH de Bento Gonçalves
# Se ausentes, cai no LEAD_NOTIFY_TO. O CV vai pro Storage do Lumied de qualquer forma.
